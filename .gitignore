# Dependencies
node_modules/
**/node_modules/

# Portable runtime and local installations
/portable/

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!backend/.env.example

# Database backups: never publish local backup contents
/database/backups/*
!/database/backups/.gitkeep

# Logs
*.log

# Generated build output
/dist/
/build/

# Temporary and editor files
*.tmp
*.temp
*.swp
*.bak
.DS_Store
Thumbs.db
# Local recovery copies
/.gitignore.backup-*
/deployment/*.backup-*
/deployment/*.previous-fix